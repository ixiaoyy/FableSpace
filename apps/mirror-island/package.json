{
  "name": "mirror-island",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "prepare:media": "node scripts/prepare-media.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "identity:up": "docker compose -f docker-compose.identity.yml up -d keycloak",
    "identity:configure": "cross-env MIRROR_ISLAND_FORUM_OIDC_CLIENT_SECRET=development-forum-oidc-client-secret MIRROR_ISLAND_FORUM_ENTRY_CLIENT_SECRET=development-forum-entry-client-secret node scripts/configure-keycloak-profile.mjs",
    "identity:down": "docker compose -f docker-compose.identity.yml down",
    "dev:services:up": "docker compose -f docker-compose.identity.yml up -d keycloak mirror-game-db",
    "dev:services:down": "docker compose -f docker-compose.identity.yml down",
    "predev": "npm run prepare:media",
    "dev": "cross-env RPG_TYPE=mmorpg vite --host 0.0.0.0",
    "predev:mmorpg": "npm run prepare:media",
    "dev:mmorpg": "cross-env RPG_TYPE=mmorpg vite --host 0.0.0.0",
    "prebuild": "npm run prepare:media && npm run prisma:generate",
    "build": "vite build",
    "prebuild:mmorpg": "npm run prepare:media && npm run prisma:generate",
    "build:mmorpg": "cross-env RPG_TYPE=mmorpg vite build",
    "prebuild:server": "npm run prepare:media && npm run prisma:generate",
    "build:server": "vite build --config vite.server.config.ts",
    "pretypecheck": "npm run prisma:generate",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run prepare:media && npm run prisma:generate",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "pretest:production": "npm run prepare:media",
    "test:production": "node --experimental-strip-types --test test/production-preview.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "Persistent RPGJS shared world for Mirror Island",
  "devDependencies": {
    "@canvasengine/compiler": "2.2.0",
    "@types/oidc-provider": "9.11.1",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "cross-env": "10.1.0",
    "path-browserify": "^1.0.1",
    "prisma": "7.9.1",
    "typescript": "6.0.3",
    "vite": "^8.2.1"
  },
  "private": true,
  "dependencies": {
    "@canvasengine/presets": "2.2.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@rpgjs/action-battle": "5.0.0-beta.32",
    "@rpgjs/client": "5.0.0-beta.32",
    "@rpgjs/common": "5.0.0-beta.30",
    "@rpgjs/server": "5.0.0-beta.32",
    "@rpgjs/tiledmap": "5.0.0-beta.32",
    "@rpgjs/ui-css": "5.0.0-beta.26",
    "@rpgjs/vite": "5.0.0-beta.32",
    "@signe/di": "^3.1.1",
    "canvasengine": "2.2.0",
    "jose": "6.2.9",
    "keycloak-js": "26.2.4",
    "oidc-provider": "9.11.1",
    "pg": "8.23.0",
    "pixi.js": "^8.19.0",
    "simplex-noise": "4.0.3",
    "ws": "8.21.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.17",
    "brace-expansion": "2.1.4",
    "esbuild": "0.28.2",
    "hono": "4.13.2",
    "immutable": "5.1.9",
    "nanoid": "3.3.18"
  },
  "type": "module"
}
