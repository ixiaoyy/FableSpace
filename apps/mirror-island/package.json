{
  "name": "mirror-island",
  "version": "1.0.0",
  "main": "dist/runtime/index.js",
  "scripts": {
    "prepare:media": "node scripts/prepare-media.mjs",
    "generate:foundation-map-fixtures": "node scripts/generate-foundation-maps.mjs",
    "format:tiled-maps": "node scripts/format-tiled-maps.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "identity:up": "docker compose -f docker-compose.identity.yml up -d keycloak",
    "identity:configure": "cross-env MIRROR_ISLAND_FORUM_OIDC_CLIENT_SECRET=development-forum-oidc-client-secret MIRROR_ISLAND_FORUM_ENTRY_CLIENT_SECRET=development-forum-entry-client-secret node scripts/configure-keycloak-profile.mjs",
    "identity:down": "docker compose -f docker-compose.identity.yml down",
    "dev:services:up": "docker compose -f docker-compose.identity.yml up -d keycloak mirror-game-db",
    "dev:services:down": "docker compose -f docker-compose.identity.yml down",
    "predev": "npm run build:client",
    "dev": "node scripts/godot.mjs serve",
    "predev:client": "npm run build:client",
    "dev:client": "node scripts/godot.mjs serve",
    "godot:setup": "node scripts/godot.mjs setup",
    "godot:prepare": "node --experimental-strip-types scripts/prepare-godot.mjs",
    "godot:prepare:tool-art": "node --experimental-strip-types scripts/prepare-godot.mjs --tool-art-preview",
    "build:tool-art": "npm run prepare:media && npm run godot:prepare:tool-art && npm run typecheck:client && node scripts/godot.mjs web && node scripts/godot.mjs windows",
    "dev:tool-art": "npm run build:tool-art && node scripts/godot.mjs serve",
    "godot:editor": "node scripts/godot.mjs editor",
    "godot:run": "node scripts/godot.mjs run",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:client",
    "prebuild:client": "npm run prepare:media && npm run godot:prepare",
    "build:client": "node scripts/godot.mjs web",
    "build:windows": "node scripts/godot.mjs windows",
    "prebuild:windows": "npm run prepare:media && npm run godot:prepare",
    "build:server": "vite build --config vite.server.config.ts",
    "pretypecheck": "npm run prisma:generate",
    "typecheck:client": "tsc --noEmit -p tsconfig.content.json && node scripts/godot.mjs check",
    "typecheck": "npm run typecheck:client && tsc --noEmit -p tsconfig.server.json",
    "test:godot": "node scripts/godot.mjs parity",
    "test:energy": "node scripts/godot.mjs energy",
    "test:fishing": "node scripts/godot.mjs fishing",
    "test:stone-fence": "node scripts/godot.mjs fence",
    "test:views": "node scripts/godot.mjs views",
    "test:identity": "node --experimental-strip-types --test test/sso-contract.test.mjs test/retirement-contract.test.mjs",
    "test:oidc": "node --experimental-strip-types --test test/sso-contract.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "Single-player Godot and GDScript farming world for Mirror Island",
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/oidc-provider": "9.11.1",
    "@types/pg": "8.23.1",
    "cross-env": "10.1.0",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  },
  "private": true,
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "express": "5.2.1",
    "jose": "6.2.9",
    "oidc-provider": "9.11.1",
    "pg": "8.23.0"
  },
  "overrides": {
    "brace-expansion": "2.1.4",
    "esbuild": "0.28.2",
    "nanoid": "3.3.18"
  },
  "type": "module"
}
