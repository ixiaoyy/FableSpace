VITE_KEYCLOAK_CLIENT_ID=mirror-island-web

KEYCLOAK_ISSUER=http://localhost:8081/realms/mirror-island
KEYCLOAK_AUDIENCE=mirror-island-game

MIRROR_GAME_POSTGRES_DB=mirror_island_game
MIRROR_GAME_POSTGRES_USER=mirror_game
MIRROR_GAME_POSTGRES_PASSWORD=mirror_game
MIRROR_ISLAND_DATABASE_URL=postgresql://mirror_game:mirror_game@localhost:5433/mirror_island_game

MIRROR_ISLAND_PUBLIC_ORIGIN=https://fable.example
PARALLELLINES_PUBLIC_BASE_URL=https://forum.example
PARALLELLINES_API_BASE_URL=http://api:8000/api/v1
PARALLELLINES_SSO_SERVICE_SECRET=replace-with-a-strong-shared-secret
