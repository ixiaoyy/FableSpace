FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32

WORKDIR /app

COPY apps/mirror-island/prisma/package.json apps/mirror-island/prisma/package-lock.json ./
RUN npm ci --ignore-scripts

COPY apps/mirror-island/prisma.config.ts ./prisma.config.ts
COPY apps/mirror-island/prisma ./prisma

ENTRYPOINT ["npx", "prisma"]
CMD ["migrate", "deploy"]
