{
  "realm": "mirror-island",
  "displayName": "镜像岛",
  "enabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["zh-CN"],
  "defaultLocale": "zh-CN",
  "loginTheme": "mirror-island",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "passwordPolicy": "maxLength(72)",
  "identityProviders": [
    {
      "alias": "parallellines",
      "displayName": "使用论坛账号",
      "providerId": "oidc",
      "enabled": true,
      "updateProfileFirstLoginMode": "off",
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "authorizationUrl": "https://fable.pingxingxian.space/forum-sso/auth",
        "tokenUrl": "https://fable.pingxingxian.space/forum-sso/token",
        "userInfoUrl": "https://fable.pingxingxian.space/forum-sso/me",
        "jwksUrl": "https://fable.pingxingxian.space/forum-sso/jwks",
        "issuer": "https://fable.pingxingxian.space/forum-sso",
        "clientId": "mirror-island-forum-bridge",
        "clientSecret": "${MIRROR_ISLAND_FORUM_OIDC_CLIENT_SECRET}",
        "clientAuthMethod": "client_secret_basic",
        "defaultScope": "openid profile",
        "syncMode": "IMPORT",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "defaultSignatureAlgorithm": "ES256",
        "pkceEnabled": "true",
        "pkceMethod": "S256"
      }
    }
  ],
  "clients": [
    {
      "clientId": "mirror-island-web",
      "name": "镜像岛 Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "https://fable.pingxingxian.space/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "https://fable.pingxingxian.space"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "mirror-island-game-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "mirror-island-game",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "mirror-island-forum-entry",
      "name": "镜像岛论坛直达引导",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${MIRROR_ISLAND_FORUM_ENTRY_CLIENT_SECRET}",
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://fable.pingxingxian.space/forum-sso/keycloak-callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "mirror-island-game",
      "name": "镜像岛 RPGJS 服务端",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ]
}
