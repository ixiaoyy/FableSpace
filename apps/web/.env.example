# Web game environment example.
# Copy this file to apps/web/.env.local for local Vite development.
# Every VITE_* value is embedded in browser assets and must be treated as public.

# Stable immutable namespace for adopted game art.
VITE_MEDIA_BASE_URL=/game-media/v1

# Ordinary community link. The game does not read forum identity or state.
VITE_FORUM_URL=https://pingxingxian.space
